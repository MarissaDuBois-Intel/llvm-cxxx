// Independent workbook oracle: expected integer encodings for inputs T,F,O.
UNARY_CASE(Identity, identity, , 1, 0, -1)
UNARY_CASE(ConstantTrue, constant, true, 1, 1, 1)
UNARY_CASE(ConstantFalse, constant, false, 0, 0, 0)
UNARY_CASE(ConstantOther, constant, other, -1, -1, -1)
UNARY_CASE(SwapTrueFalse, swap, true-false, 0, 1, -1)
UNARY_CASE(SwapTrueOther, swap, true-other, -1, 0, 1)
UNARY_CASE(SwapFalseOther, swap, false-other, 1, -1, 0)
UNARY_CASE(CycleForward, cycle, forward, -1, 1, 0)
UNARY_CASE(CycleBackward, cycle, backward, 0, -1, 1)
UNARY_CASE(CollapseTrueFalse, collapse, true-false, 0, 0, -1)
UNARY_CASE(CollapseTrueOther, collapse, true-other, -1, 0, -1)
UNARY_CASE(CollapseFalseTrue, collapse, false-true, 1, 1, -1)
UNARY_CASE(CollapseFalseOther, collapse, false-other, 1, -1, -1)
UNARY_CASE(CollapseOtherTrue, collapse, other-true, 1, 0, 1)
UNARY_CASE(CollapseOtherFalse, collapse, other-false, 1, 0, 0)
UNARY_CASE(ChainTrueFalse, chain, true-false, 1, 1, 0)
UNARY_CASE(ChainTrueOther, chain, true-other, 1, -1, 1)
UNARY_CASE(ChainFalseTrue, chain, false-true, 0, 0, 1)
UNARY_CASE(ChainFalseOther, chain, false-other, -1, 0, 0)
UNARY_CASE(ChainOtherTrue, chain, other-true, -1, 1, -1)
UNARY_CASE(ChainOtherFalse, chain, other-false, 0, -1, -1)
UNARY_CASE(FeedTrueFalseTrue, feed, true-false-true, 0, 1, 1)
UNARY_CASE(FeedTrueFalseFalse, feed, true-false-false, 0, 1, 0)
UNARY_CASE(FeedTrueOtherTrue, feed, true-other-true, -1, 1, 1)
UNARY_CASE(FeedTrueOtherOther, feed, true-other-other, -1, -1, 1)
UNARY_CASE(FeedFalseOtherFalse, feed, false-other-false, 0, -1, 0)
UNARY_CASE(FeedFalseOtherOther, feed, false-other-other, -1, -1, 0)
